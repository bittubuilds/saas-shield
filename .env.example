# SaaS Shield environment configuration (example - no real secrets)
# Copy to .env and adjust. Never commit real secrets.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Base URL used for links in exported reports (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# SQLite database file path
DATABASE_FILE=./data/saas-shield.db

# Session cookie settings
SESSION_TTL_HOURS=168
COOKIE_SECURE=false        # set to true when serving over HTTPS
COOKIE_SAME_SITE=lax

# Auth rate limiting (requests per window, per IP)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MINUTES=15

# Crawler limits
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_PAGES_PER_SITE=25
CRAWL_MAX_DEPTH=2
CRAWL_MAX_RESPONSE_BYTES=2097152
CRAWL_DELAY_MS=1000
CRAWL_USER_AGENT=SaaSShieldBot/0.1 (+https://saas-shield.example/bot)
CRAWL_RESPECT_ROBOTS=true

# SSRF protection
# WARNING: only set to true for local development and automated tests.
# When true, the crawler may reach loopback/private addresses.
SHIELD_ALLOW_PRIVATE_IPS=false

# Similarity engine
SIM_MIN_SHINGLE_JACCARD=0.12
SIM_MIN_TFIDF_COSINE=0.25
SIM_MIN_PASSAGE_WORDS=12
SIM_SHINGLE_SIZE=5

# Retention: days to keep evidence excerpts for dismissed findings (0 = keep forever)
RETENTION_DAYS=0
