# SaaS Shield configuration. Copy to .env and adjust. Never commit real secrets.
# Every value is optional; the defaults shown are the ones the code uses.

# Runtime
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
DATABASE_FILE=
PUBLIC_BASE_URL=
TRUST_PROXY_HOPS=1
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Auth / email verification
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_GRANDFATHER_EXISTING=true
AUTH_VERIFICATION_TTL_HOURS=24
AUTH_VERIFICATION_RESEND_MAX=5
AUTH_VERIFICATION_RESEND_WINDOW_MINUTES=60
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MINUTES=15
AUTH_DEV_EXPOSE_LINK=false

# Email delivery. Empty EMAIL_PROVIDER = nothing is sent and the app reports that honestly.
EMAIL_PROVIDER=
EMAIL_FROM=SaaS Shield <no-reply@saas-shield.local>
RESEND_API_KEY=
RESEND_ENDPOINT=https://api.resend.com/emails
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_TIMEOUT_MS=10000
EMAIL_DEV_SINK=

# Google sign-in (optional; disabled while CLIENT_ID/SECRET are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ISSUER=https://accounts.google.com

# Scheduling and alerts
ENABLE_INTERNAL_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_LOCK_TTL_SECONDS=600
CRON_SECRET=
ALERT_RETRY_DELAYS_MINUTES=5,30,120
DIGEST_DEFAULT_DAY=1
DIGEST_DEFAULT_HOUR_UTC=8

# Crawler and SSRF protection
SHIELD_ALLOW_PRIVATE_IPS=false
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_PAGES_PER_SITE=25
CRAWL_MAX_DEPTH=2
CRAWL_MAX_RESPONSE_BYTES=2097152
CRAWL_DELAY_MS=1000
CRAWL_USER_AGENT=SaaSShieldBot/0.1 (+https://saas-shield.example/bot)
CRAWL_RESPECT_ROBOTS=true

# Monitoring thresholds
MONITOR_DEFAULT_FREQUENCY_HOURS=24
MONITOR_MAX_PAGES_PER_SITE=12
MONITOR_MAX_CHECKS_PER_TICK=6
MONITOR_STALE_CHECK_MINUTES=20
MONITOR_NOTIFY_MIN_SIGNIFICANCE=0.4
RETENTION_DAYS=0

# Similarity thresholds (documented in the app; change only with evidence)
SIM_SHINGLE_SIZE=5
SIM_MIN_SHINGLE_JACCARD=0.12
SIM_MIN_SHORT_SHINGLE_JACCARD=0.05
SIM_MIN_TFIDF_COSINE=0.25
SIM_MIN_COSINE_WORDS=140
SIM_MIN_PASSAGE_WORDS=12
SIM_MIN_STRUCTURAL_SCORE=0.55

# Resend delivery webhooks (optional but recommended).
# Resend dashboard -> Webhooks -> add endpoint https://<your-app>/api/webhooks/resend
# and paste the signing secret (whsec_...) here. Delivery status (delivered,
# bounced, complained) is only tracked when this is set; the endpoint stays
# closed otherwise.
RESEND_WEBHOOK_SECRET=

# --- Optional capabilities (the app runs without all of them) ---
# Read sitemap.xml so monitoring finds pages a JS-only nav would hide.
MONITOR_USE_SITEMAP=true
# SERPER_API_KEY is OPTIONAL: it only powers auto-discovery of sites that may have
# copied yours. Without it, register comparison sites by URL.
# EMAIL_PROVIDER / RESEND_API_KEY / EMAIL_FROM are OPTIONAL: without a provider (or
# with Resend's test sender) the app runs in instant auth mode instead of blocking signup.

# Optional. When set, SaaS Shield uses PostgreSQL instead of SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Database durability ---------------------------------------------------
# DATABASE_URL selects PostgreSQL; without it the app uses SQLite below.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SQLite file location (default: ./data/saas-shield.db).
# DATABASE_FILE=./data/saas-shield.db
# Directory you have declared persistent (a mounted disk). Only used to stop the
# "not durable" warning on SQLite; PostgreSQL never needs it.
# DB_PERSISTENT_PATH=/var/data
# Refuse to start when storage cannot survive a deploy. Recommended in production.
# DB_REQUIRE_DURABLE=true
# Where tools/db-backup.js writes snapshots, and how many to keep.
# DB_BACKUP_DIR=./backups
# DB_BACKUP_KEEP=7
# PostgreSQL pool size per process.
# PG_POOL_MAX=10

# --- AI intelligence (optional; the app runs without it) -------------------
# Verified 2026-11-07 against Groq's published rate-limit documentation:
# openai/gpt-oss-120b on the Free plan = 30 requests/min, 1,000 requests/day,
# 8,000 tokens/min, 200,000 tokens/day. Models not listed here are unverified.
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
# AI_TEMPERATURE=0.1
# AI_MAX_OUTPUT_TOKENS=1400
# AI_MIN_PAGE_CHARS=80
# AI_MAX_COMPETITORS=6
# AI_MAX_PAGES=3
# AI_MAX_PAGE_CHARS=4000
# AI_MAX_REQUESTS_PER_SCAN=40
# AI_MAX_REQUESTS_PER_DAY=200
# AI_MAX_ATTEMPTS=3

# --- Evidence freshness (Phase 4 -> Phase 5) --------------------------------
# How long collected evidence counts as fresh. Past this window the competitor is
# due a recrawl; inside it, a fetch is skipped unless the last attempt failed.
# EVIDENCE_FRESH_TTL_HOURS=168

# --- Screenshot capture (Phase 4 visual evidence) ---------------------------
# Off by default: a headless browser is not available on every host, and this is
# optional. Requires playwright + Chromium: npm install && npm run screenshots:install
# SHOT_ENABLED=false
# SHOT_STORAGE=local            # local | memory (both non-durable; see docs/SCREENSHOTS.md)
# SHOT_DIR=./data/screenshots
# SHOT_MAX_PER_COMPETITOR=4
# SHOT_CONCURRENCY=1
# SHOT_TIMEOUT_MS=15000
# SHOT_NAV_TIMEOUT_MS=12000
# SHOT_MAX_BYTES=2097152
# SHOT_VIEWPORT_WIDTH=1280
# SHOT_VIEWPORT_HEIGHT=900
# SHOT_FULL_PAGE=false
# SHOT_MAX_HEIGHT=2400
